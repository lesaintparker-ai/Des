{
  "name": "jingle-a-la-decouverte",
  "private": true,
  "description": "Jingle motion design « À LA DÉCOUVERTE » — rendu image par image vers MP4",
  "scripts": {
    "audio": "python3 -I audio/synth.py src/cues.js audio/jingle.wav",
